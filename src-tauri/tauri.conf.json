{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RivalNxt",
  "version": "0.10.1",
  "identifier": "com.rivalnxt.modmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../build"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/frontendlogo.ico"],
    "resources": [],
    "externalBin": ["sidecars/rivalnxt_backend"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "RivalNxt",
        "width": 1366,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4MEJGMkU1ODRENzQzRUYKUldUdlE5ZUU1ZklMT0k5cGhkZ1Z2TmRXR1lETzh0d3Y1WTZySHB0QStSTTV0MmJZaHZpMWlvSkgK",
      "endpoints": ["https://github.com/cort-robinson/RivalNxt/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    },
    "shell": {
      "open": "(https?|nxm|steam)://.*"
    },
    "deepLink": {
      "schemes": ["nxm"]
    }
  }
}
